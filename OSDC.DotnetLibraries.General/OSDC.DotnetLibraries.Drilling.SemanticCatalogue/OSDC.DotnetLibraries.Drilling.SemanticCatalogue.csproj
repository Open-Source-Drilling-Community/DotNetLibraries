<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0</Version>
    <Authors>Eric Cayeux</Authors>
    <Company>NORCE Norwegian Research Centre</Company>
    <Description>Versioned OSDC semantic concepts, roles and reference conventions with authoritative physical-quantity bindings.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Open-Source-Drilling-Community/DotNetLibraries</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OSDC.UnitConversion.Conversion.DrillingEngineering" Version="3.4.2" />
    <EmbeddedResource Include="catalogue.json" />
    <None Update="catalogue.json;catalogue.schema.json" Pack="true" PackagePath="catalogue/" />
    <None Update="CURATION.md;CURATION-DECISIONS.md;CURATION-REVIEW-2026-09-26.md" Pack="true" PackagePath="/" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
