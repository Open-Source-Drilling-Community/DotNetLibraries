<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <Authors>Eric Cayeux</Authors>
    <Company>NORCE Norwegian Research Centre</Company>
    <Description>Versioned OSDC semantic concepts, roles and reference conventions with authoritative physical-quantity bindings.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Open-Source-Drilling-Community/DotNetLibraries</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup>
    <UseLocalUnitConversionProjects Condition="'$(UseLocalUnitConversionProjects)' == '' and Exists('../../../UnitConversion/Conversion/Conversion.csproj')">true</UseLocalUnitConversionProjects>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Condition="'$(UseLocalUnitConversionProjects)' == 'true'" Include="../../../UnitConversion/Conversion/Conversion.csproj" />
    <ProjectReference Condition="'$(UseLocalUnitConversionProjects)' == 'true'" Include="../../../UnitConversion/Conversion.DrillingEngineering/Conversion.DrillingEngineering.csproj" />
    <PackageReference Condition="'$(UseLocalUnitConversionProjects)' != 'true'" Include="OSDC.UnitConversion.Conversion" Version="3.3.28" />
    <PackageReference Condition="'$(UseLocalUnitConversionProjects)' != 'true'" Include="OSDC.UnitConversion.Conversion.DrillingEngineering" Version="3.3.28" />
    <EmbeddedResource Include="catalogue.json" />
    <None Update="catalogue.json;catalogue.schema.json" Pack="true" PackagePath="catalogue/" />
    <None Update="CURATION.md" Pack="true" PackagePath="/" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
