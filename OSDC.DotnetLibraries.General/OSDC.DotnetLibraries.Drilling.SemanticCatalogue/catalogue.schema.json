{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSDC Semantic Catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "schemaVersion",
    "concepts"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "definition",
          "kind",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "Noun",
              "Role",
              "Reference"
            ]
          },
          "status": {
            "enum": [
              "Proposed",
              "Reviewed",
              "Deprecated"
            ]
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "requiredContext": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "quantityName": {
            "type": [
              "string",
              "null"
            ]
          },
          "siUnit": {
            "type": [
              "string",
              "null"
            ]
          },
          "supersededBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "target"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "HasPart",
                    "LocatedAt",
                    "EvaluatedUsing",
                    "HasInput",
                    "Produces",
                    "ProjectionOf"
                  ]
                },
                "target": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "referenceProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "bindings"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "concept",
                "reference"
              ],
              "properties": {
                "concept": {
                  "type": "string"
                },
                "reference": {
                  "type": "string"
                }
              }
            }
          },
          "scope": {
            "const": "canonical-storage-and-api"
          }
        }
      }
    }
  }
}
